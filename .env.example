# ============================================
# FABLE - Variables d'environnement (exemple)
# Copier ce fichier en .env et remplir les valeurs
# JAMAIS committer .env (voir .gitignore)
# ============================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google (Gemini - optionnel) ---
GOOGLE_API_KEY=

# --- fal.ai (images FLUX) ---
FAL_API_KEY=

# --- Supabase (base de données + auth + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mobile (apps/mobile/.env) : mêmes URL + clé ANON avec le préfixe EXPO_PUBLIC_ ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=